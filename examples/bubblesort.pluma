let L = list with 8,1,7,2,5,4,3,6,9,0

let n = length L

foreach i in range from 0 to n-1 then
    foreach j in range from 0 to n-i-1 then
        if j from L > (j+1) from L then
            let a = j from L
            let b = (j+1) from L

            j from L = b
            (j+1) from L = a

print L
