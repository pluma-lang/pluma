let Person = map with "name": "", "age": 0

function make_person with name, age
    let new = copy Person
    "name" from new = name
    "age" from new = age
    return new


let julia = make_person with "Julia", 21
let jacob = make_person with "Jacob", 24

let people = list with julia, jacob

foreach p in people then
    foreach k in p then
        print k + ":"
        print k from p
    print ""
