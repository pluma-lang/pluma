# tape initialization
let tape = list with nothing
let i = 0
while i < 255 then
    tape = tape + list with 0
    i = i + 1

let ptr = 0
function execute with code

    let i = 0
    while i < length code then
        let command = i from code
        if command == ">" then
            ptr = ptr + 1

            if ptr > 254 then
                ptr = 0

        if command == "<" then
            ptr = ptr - 1

            if ptr < 0 then
                ptr = 254

        if command == "+" then
            ptr from tape = ptr from tape + 1

            if ptr from tape > 255 then
                ptr from tape = 0

        if command == "-" then
            ptr from tape = ptr from tape - 1

            if ptr from tape < 0 then
                ptr from tape = 255

        if command == "." then
            foreach char in letters then
                if ptr from tape == char from letters then
                    print char

        if command == "," then
            let c = 0 from (input "")

            ptr from tape = c from letters

        if command == "[" then
            let loop_inst = list with nothing

            let j = i + 1
            let depth = 1

            while j < length code and depth > 0 then
                let current = j from code

                if current == "[" then
                    depth = depth + 1

                if current == "]" then
                    depth = depth - 1

                if depth > 0 then
                    loop_inst = loop_inst + list with current

                j = j + 1

            while ptr from tape != 0 then
                execute with loop_inst

            i = j - 1

        i = i+1

# code goes here
let code = "--<-<<+[+[<+>--->->->-<<<]>]<<--.<++++++.<<-..<<.<+.>>.>>.<<<.+++.>>.>>-.<<<+."

execute with code
