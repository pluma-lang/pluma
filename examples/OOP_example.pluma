let Person be map with
    "name": nothing
    "age": nothing

    "make": function with name, age
        let new be copy itself
        "name" from new is name
        "age" from new is age
        return new

    "eat": function with food
        print ("name" from itself) + " ate " + food

let Bob be ("make" from Person) with "Bob", 21

("eat" from Bob) with "popcorn"
